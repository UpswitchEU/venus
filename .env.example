# Venus (Valuation Calculator) - Environment Variables
# Copy this file to .env.local for local development
# See env.example for full Next.js configuration

# =============================================================================
# MVP LAUNCH - Required for production
# =============================================================================
# Backend API (Titan) - Used for auth, valuations, AI chat
# Development: http://localhost:3002 (Titan default port)
# Staging: https://api-staging.upswitch.app
# Production: https://api.upswitch.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Parent domain (Mercury) - For return URLs and auth redirects
# Production: https://upswitch.app
NEXT_PUBLIC_PARENT_DOMAIN=http://localhost:3000

# Cookie domain - Used for setting/clearing auth cookies
# Development: localhost
# Production: .upswitch.app
COOKIE_DOMAIN=localhost
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# Mercury URL - For cross-app navigation (return to dashboard, etc.)
# Production: https://www.upswitch.app
NEXT_PUBLIC_MERCURY_URL=http://localhost:3000

# Python Engine (ValuationIQ) - Direct URL for valuation calculations
# Production: https://api-valuations.upswitch.app
NEXT_PUBLIC_PYTHON_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_VALUATION_ENGINE_URL=http://localhost:8000

# =============================================================================
# LEGACY (Vite - deprecated, Venus is now Next.js)
# =============================================================================
VITE_API_BASE_URL=http://localhost:5001
VITE_BACKEND_URL=http://localhost:5001
VITE_PARENT_DOMAIN=http://localhost:3000

# =============================================================================
# INVISIBLE FENCES (AI Usage)
# =============================================================================
NEXT_PUBLIC_UNLIMITED_CREDITS_MODE=true
