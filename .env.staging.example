# Venus - Staging Environment Variables
# Copy these values into Vercel Dashboard → Settings → Environment Variables → Preview
# Used when deploying the staging branch to preview.valuation.upswitch.app
# See docs/operations/ENV_URL_MATRIX.md for URL reference
#
# Custom domain (Option C): api-staging.upswitch.app, api-staging-valuations.upswitch.app
# Railway URL (Option D): titan-staging.up.railway.app, valuationiq-staging.up.railway.app

NEXT_PUBLIC_APP_URL=https://preview.valuation.upswitch.app
NEXT_PUBLIC_BACKEND_URL=https://api-staging.upswitch.app
NEXT_PUBLIC_API_BASE_URL=https://api-staging.upswitch.app
NEXT_PUBLIC_VALUATION_ENGINE_URL=https://api-staging-valuations.upswitch.app
NEXT_PUBLIC_VALUATION_API_URL=https://api-staging-valuations.upswitch.app
NEXT_PUBLIC_PARENT_DOMAIN=https://staging.upswitch.app
NEXT_PUBLIC_SUPABASE_URL=<staging-supabase-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>
COOKIE_DOMAIN=.upswitch.app
