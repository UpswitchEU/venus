# ============================================================================
# Venus (Valuation Tester) - Environment Variables (Next.js)
# ============================================================================
# IMPORTANT: Client-side env vars MUST be prefixed with NEXT_PUBLIC_
# Vercel automatically injects these during build
#
# Next.js app running on port 3001
# Subdomain: valuation.upswitch.app
#
# Authentication: Uses shared cookies from Titan API (api.upswitch.app)
# - upswitch_access_token (15 min, HTTP-only, domain: .upswitch.app)
# - upswitch_refresh_token (7 days, HTTP-only, domain: .upswitch.app)
# Fallback: Main domain cookie check (.upswitch.app)
# ============================================================================

# App URL (Venus - Calculator subdomain)
# Production: https://valuation.upswitch.app
# Local Dev: http://localhost:3001
NEXT_PUBLIC_APP_URL=https://valuation.upswitch.app

# Backend API Configuration (Titan API)
# Used for authentication, data persistence, and valuation orchestration
NEXT_PUBLIC_BACKEND_URL=https://api.upswitch.app
NEXT_PUBLIC_API_BASE_URL=https://api.upswitch.app

# Valuation Engine API (Python backend)
# Used for business valuation calculations
NEXT_PUBLIC_VALUATION_ENGINE_URL=https://api.valuations.upswitch.app
NEXT_PUBLIC_VALUATION_API_URL=https://api.valuations.upswitch.app

# Supabase Configuration
# Used for database access and authentication
NEXT_PUBLIC_SUPABASE_URL=https://vrxsdtmsvdjpteynqnqc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZyeHNkdG1zdmRqcHRleW5xbnFjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTc1MDYzNTcsImV4cCI6MjA3MzA4MjM1N30.QPB6lW9GjET-WDdWL29RccD1gnhpDWOnhSQVnSowIxE

# Cookie Configuration
# Domain for cross-subdomain cookie sharing
# Production: .upswitch.app (allows upswitch.app, valuation.upswitch.app, etc.)
# Local Dev: localhost
NEXT_PUBLIC_PARENT_DOMAIN=https://upswitch.app
COOKIE_DOMAIN=.upswitch.app

# Feature Flags
NEXT_PUBLIC_ENABLE_REGISTRY=true
NEXT_PUBLIC_ENABLE_DOCUMENT_UPLOAD=true
NEXT_PUBLIC_ENABLE_AI_CONVERSATION=true

# =============================================================================
# INVISIBLE FENCES (AI Usage - Internal Only)
# =============================================================================
# When true, hides credit UI and enables unlimited AI access
# Part of "Invisible Fences" strategy - users get unlimited access, we monitor internally
# Set to true for production to avoid "metered anxiety" for accountants
# Protection layers: Scoped AI (Claude), Rate Limits (50/hr), Fair Use Alerts ($5/mo)
NEXT_PUBLIC_UNLIMITED_CREDITS_MODE=true

# Development Settings
NEXT_PUBLIC_DEBUG=false

# ============================================================================
# Local Development Configuration
# ============================================================================
# Uncomment these for local development
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_VALUATION_ENGINE_URL=http://localhost:8000
# NEXT_PUBLIC_PARENT_DOMAIN=http://localhost:3001
# COOKIE_DOMAIN=localhost
# NEXT_PUBLIC_DEBUG=true
# Note: NEXT_PUBLIC_UNLIMITED_CREDITS_MODE is already true by default (Invisible Fences)

# ============================================================================
# Authentication Flow (Shared Cookies with Titan)
# ============================================================================
# 1. User logs in on Mercury (upswitch.app)
# 2. Mercury calls Titan API (/api/v2/auth/login)
# 3. Titan sets cookies on domain .upswitch.app
# 4. User navigates to Venus (valuation.upswitch.app)
# 5. Venus reads shared cookies automatically (browser sends them)
# 6. Venus calls Titan API (/api/v2/auth/me) to verify
# 7. Venus refreshes tokens every 5 minutes (/api/v2/auth/refresh)
# 8. Fallback: Main domain cookie check if shared cookie not available
# ============================================================================

# ============================================================================
# Migration Note: VITE_* → NEXT_PUBLIC_*
# ============================================================================
# Venus was migrated from Vite to Next.js environment variables
# Old VITE_* variables are no longer supported
# Use NEXT_PUBLIC_* prefix for all client-side environment variables
# ============================================================================
