{
  "name": "venus",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.26.2"
  },
  "description": "Venus - UpSwitch Valuation Calculator Frontend - The Oracle's wisdom for business insights",
  "type": "module",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --port 3001",
    "build": "pnpm --dir vendor/ai-actions build && node scripts/verify-messages-json.mjs && node scripts/generate-favicons.mjs && next build",
    "vercel-build": "pnpm --dir vendor/ai-actions build && node scripts/verify-messages-json.mjs && node scripts/generate-favicons.mjs && next build",
    "start": "next start --port 3001",
    "audit": "pnpm audit --prod --audit-level high",
    "guard:bundle-budget": "node scripts/guard-bundle-budget.mjs",
    "guard:auth-surface": "node scripts/guard-auth-surface.mjs",
    "guard:debug-surface": "node scripts/guard-debug-surface.mjs",
    "guard:debug-surface:update": "node scripts/guard-debug-surface.mjs --write-baseline",
    "guard:browser-persistence": "node scripts/guard-browser-persistence.mjs",
    "guard:secret-hygiene": "node scripts/guard-secret-hygiene.mjs",
    "guard:security-headers": "node scripts/guard-security-headers.mjs",
    "guard:file-size": "node scripts/guard-file-size.mjs",
    "guard:file-size:update": "node scripts/guard-file-size.mjs --write-baseline",
    "guard:repo-hygiene": "node scripts/guard-repo-hygiene.mjs",
    "guard:exact-boundary": "node scripts/guard-exact-boundary.cjs",
    "guard:type-debt": "node scripts/guard-type-debt.mjs",
    "guard:type-debt:update": "node scripts/guard-type-debt.mjs --write-baseline",
    "guard:standalone-deps": "node scripts/guard-standalone-deps.mjs",
    "guard:preseed": "pnpm run guard:repo-hygiene && pnpm run guard:secret-hygiene && pnpm run guard:auth-surface && pnpm run guard:browser-persistence && pnpm run guard:security-headers && pnpm run guard:type-debt && pnpm run guard:standalone-deps",
    "lint": "biome check --max-diagnostics=1500 src/ app/",
    "lint:fix": "biome check --max-diagnostics=1500 src/ app/ --write",
    "format": "biome format src/ app/",
    "format:write": "biome format src/ app/ --write",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze-bundle": "ANALYZE=true next build",
    "bundle-report": "node scripts/analyze-bundle.js",
    "i18n:check": "node scripts/check-translations.cjs",
    "verify:messages": "node scripts/verify-messages-json.mjs",
    "verify:shared-contracts": "upswitch-platform verify:shared-contracts",
    "verify:sellability-contracts": "upswitch-platform verify:sellability-contracts",
    "verify:preparer-multiple-contracts": "upswitch-platform verify:preparer-multiple-contracts",
    "verify:ai-conversation-key-contracts": "upswitch-platform verify:ai-conversation-key-contracts",
    "verify:ai-tool-result-contracts": "upswitch-platform verify:ai-tool-result-contracts",
    "verify:ai-dock-shells": "upswitch-platform verify:ai-dock-shells",
    "verify:internal-email-contracts": "upswitch-platform verify:internal-email-contracts",
    "verify:auth-fetch-timeout-contracts": "upswitch-platform verify:auth-fetch-timeout-contracts",
    "verify:valuation-extract": "upswitch-platform verify:valuation-extract",
    "verify:valuation-method-contracts": "node ../../packages/platform-scripts/bin/upswitch-platform.mjs verify:valuation-method-contracts",
    "verify:brand-favicons": "upswitch-platform verify:brand-favicons",
    "sync:shared-contracts": "upswitch-platform sync:shared-contracts",
    "sync:ai-actions-contracts": "upswitch-platform sync:ai-actions-contracts",
    "sync:ai-dock-shells": "upswitch-platform sync:ai-dock-shells",
    "sync:valuation-method-contracts": "node ../../packages/platform-scripts/bin/upswitch-platform.mjs sync:valuation-method-contracts",
    "deploy": "./deploy.sh",
    "deploy:vercel": "./deploy.sh vercel",
    "deploy:netlify": "./deploy.sh netlify",
    "deploy:aws": "./deploy.sh aws"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.13.18",
    "@upswitch/ai-actions": "file:./vendor/ai-actions",
    "@upswitch/types": "file:./vendor/types",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.4.3",
    "dompurify": "^3.4.5",
    "eventsource": "^4.0.0",
    "framer-motion": "^12.23.12",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.400.0",
    "next": "15.5.18",
    "next-intl": "^4.12.0",
    "next-view-transitions": "^0.3.5",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "posthog-js": "^1.374.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/eventsource": "^1.1.15",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@upswitch/platform-scripts": "file:./vendor/platform-scripts",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.18",
    "critters": "^0.0.23",
    "jsdom": "^26.1.0",
    "playwright": "^1.57.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.14",
    "sharp": "^0.34.5",
    "typescript": "^5.2.2",
    "vitest": "^4.0.15"
  },
  "keywords": [
    "valuation",
    "business",
    "M&A",
    "testing",
    "react",
    "typescript"
  ],
  "author": "Upswitch Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/UpswitchEU/venus.git"
  },
  "bugs": {
    "url": "https://github.com/UpswitchEU/venus/issues"
  },
  "homepage": "https://www.upswitch.app",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "@protobufjs/utf8": "1.1.1",
      "flatted": "^3.4.2",
      "lodash": "4.18.1",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <5": "4.0.4",
      "postcss": "8.5.14",
      "protobufjs": "7.6.0",
      "rollup": "^4.59.0",
      "vite": "^7.3.2"
    }
  },
  "resolutions": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  }
}
