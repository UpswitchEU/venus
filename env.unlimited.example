# Unlimited Credits Mode Configuration for Valuation Tester
# Copy this to .env.local to enable unlimited credits mode
# Note: Venus is now using Next.js (NEXT_PUBLIC_ prefix)

# Credit System Configuration
NEXT_PUBLIC_UNLIMITED_CREDITS_MODE=true
NEXT_PUBLIC_SHOW_CREDIT_BADGE=true
NEXT_PUBLIC_SHOW_USAGE_STATS=true
NEXT_PUBLIC_ENABLE_PREMIUM_UPSELL=false

# UI/UX Configuration
NEXT_PUBLIC_SHOW_ONBOARDING_TOOLTIPS=true
NEXT_PUBLIC_ENABLE_ANIMATIONS=true
NEXT_PUBLIC_SHOW_CREDIT_ANALYTICS=true

# Development Configuration
NEXT_PUBLIC_DEBUG_CREDIT_SYSTEM=false
NEXT_PUBLIC_MOCK_CREDIT_DATA=false

# API Configuration (Titan Backend)
NEXT_PUBLIC_API_URL=https://api.upswitch.app
NEXT_PUBLIC_CREDIT_API_URL=https://api.upswitch.app/api/credits
NEXT_PUBLIC_BACKEND_URL=https://api.upswitch.app
NEXT_PUBLIC_API_BASE_URL=https://api.upswitch.app

# Cookie Domain for Cross-Subdomain Authentication
COOKIE_DOMAIN=.upswitch.app
